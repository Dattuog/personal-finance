# Application and authentication
# AUTH_SECRET and SMTP credentials are server-only. Never use NEXT_PUBLIC_ for secrets.
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace_with_32_plus_random_bytes

# PostgreSQL
# Replace every uppercase placeholder before starting the application.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Passwordless email authentication
EMAIL_SERVER=smtp://SMTP_USER:SMTP_PASSWORD@SMTP_HOST:587
EMAIL_FROM=FinPilot AI <no-reply@localhost>

# AI provider
AI_PROVIDER=gemini
AI_MONTHLY_USER_REQUEST_LIMIT=20
AI_MAX_OUTPUT_TOKENS=1500

# Google Gemini (optional and server-only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=configured_model_here

# Docker Compose development database (not read by the application itself)
POSTGRES_DB=finpilot
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=replace_with_a_local_database_password
